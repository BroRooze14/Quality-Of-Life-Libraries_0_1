":88,"diffs":[[1,"/**\n * Custom blocks for creating and managing 2D grids\n */\n//% weight=100 color=#6a1b9a icon=\"\\uf00a\" block=\"Grid Tools\"\nnamespace gridTools {\n\n    //% blockNamespace=gridTools\n    export class Grid {\n        private data: string[][];\n        private rows: number;\n        private cols: number;\n        private placeholder: string;\n        private useDescriptiveEmpty: boolean;\n        private name: string;\n\n        private limitSize: boolean;\n        private maxCols: number;\n        private maxRows: number;\n\n        constructor(cols: number, rows: number) {\n            this.cols = cols;\n            this.rows = rows;\n            this.placeholder = \".\";\n            this.useDescriptiveEmpty = false;\n            this.name = \"myGrid\";\n\n            this.limitSize = false;\n            this.maxCols = cols;\n            this.maxRows = rows;\n\n            this.data = [];\n            this.clearAll();\n        }\n\n        /**\n         * Set a value at a specific X and Y coordinate.\n         */\n        //% block=\"set %this value at x %x y %y to %value\"\n        //% x.defl=0 y.defl=0 value.defl=\"X\"\n        public set(x: number, y: number, value: string): void {\n            if (x < 0 || y < 0) {\n                serial.writeLine(this.name + \" (\" + x + \",\" + y + \") out of grid range\");\n                return;\n            }\n\n            if (this.limitSize) {\n                if (x >= this.maxCols || y >= this.maxRows) {\n                    serial.writeLine(this.name + \" (\" + x + \",\" + y + \") out of grid range\");\n                    return;\n                }\n                this.expandGridIfNeeded(x, y);\n            } else {\n                this.expandGridIfNeeded(x, y);\n            }\n\n            this.data[y][x] = value;\n        }\n\n        /**\n         * Get a value from a specific X and Y coordinate.\n         */\n        //% block=\"get value from %this at x %x y %y\"\n        //% x.defl=0 y.defl=0\n        public get(x: number, y: number): string {\n            if (x >= 0 && x < this.cols && y >= 0 && y < this.rows) {\n                return this.data[y][x];\n            }\n            return this.useDescriptiveEmpty ? \"(-empty-)\" : this.placeholder;\n        }\n\n        /**\n         * Limit the maximum allowed size of the grid.\n         */\n        //% block=\"limit size of %this to max columns %maxCols max rows %maxRows\"\n        //% maxCols.defl=10 maxRows.defl=10\n        public limitGridSize(maxCols: number, maxRows: number): void {\n            this.limitSize = true;\n            this.maxCols = maxCols;\n            this.maxRows = maxRows;\n        }\n\n        /**\n         * Disable grid limits allowing it to grow automatically.\n         */\n        //% block=\"allow %this to grow infinitely\"\n        public disableGridLimits(): void {\n            this.limitSize = false;\n        }\n\n        /**\n         * Set the grid reporting name for out of bounds alerts.\n         */\n        //% block=\"set grid name for %this to %name\"\n        //% name.defl=\"myGrid\"\n        public setGridName(name: string): void {\n            this.name = name;\n        }\n\n        /**\n         * Set a custom default character for empty cells.\n         */\n        //% block=\"set default character for %this to %char\"\n        //% char.defl=\".\"\n        public setDefaultCharacter(char: string): void {\n            let oldPlaceholder = this.placeholder;\n            this.placeholder = char;\n\n            for (let y = 0; y < this.rows; y++) {\n                for (let x = 0; x < this.cols; x++) {\n                    if (this.data[y][x] === oldPlaceholder) {\n                        this.data[y][x] = this.placeholder;\n                    }\n                }\n            }\n        }\n\n        /**\n         * Clear a specific coordinate back to the default state.\n         */\n        //% block=\"clear coordinate at x %x y %y in %this\"\n        //% x.defl=0 y.defl=0\n        public clearCoordinate(x: number, y: number): void {\n            if (x >= 0 && x < this.cols && y >= 0 && y < this.rows) {\n                this.data[y][x] = this.placeholder;\n            }\n        }\n\n        /**\n         * Reset the entire grid back to empty placeholders.\n         */\n        //% block=\"reset grid %this\"\n        public clearAll(): void {\n            this.data = [];\n            let initialRows = this.limitSize ? this.maxRows : this.rows;\n            let initialCols = this.limitSize ? this.maxCols : this.cols;\n\n            this.rows = initialRows > 0 ? initialRows : 1;\n            this.cols = initialCols > 0 ? initialCols : 1;\n\n            for (let y = 0; y < this.rows; y++) {\n                let rowArray: string[] = [];\n                for (let x = 0; x < this.cols; x++) {\n                    rowArray.push(this.placeholder);\n                }\n                this.data.push(rowArray);\n            }\n        }\n\n        /**\n         * Print the complete grid layout to the terminal.\n         */\n        //% block=\"show %this in terminal\"\n        public showInTerminal(): void {\n            serial.writeLine(\"--- Grid Render: \" + this.name + \" ---\");\n            for (let y = 0; y < this.rows; y++) {\n                let rowString = \"\";\n                for (let x = 0; x < this.cols; x++) {\n                    let currentVal = this.data[y][x];\n                    if (this.useDescriptiveEmpty && currentVal === this.placeholder) {\n                        rowString += \"(-empty-) \";\n                    } else {\n                        rowString += currentVal + \" \";\n                    }\n                }\n                serial.writeLine(rowString);\n            }\n            serial.writeLine(\"-------------------\");\n        }\n\n        private expandGridIfNeeded(targetX: number, targetY: number): void {\n            let requiredCols = Math.max(this.cols, targetX + 1);\n            let requiredRows = Math.max(this.rows, targetY + 1);\n\n            if (requiredCols > this.cols) {\n                for (let y = 0; y < this.rows; y++) {\n                    while (this.data[y].length < requiredCols) {\n                        this.data[y].push(this.placeholder);\n                    }\n                }\n                this.cols = requiredCols;\n            }\n\n            if (requiredRows > this.rows) {\n                for (let y = this.rows; y < requiredRows; y++) {\n                    let rowArray: string[] = [];\n                    for (let x = 0; x < this.cols; x++) {\n                        rowArray.push(this.placeholder);\n                    }\n                    this.data.push(rowArray);\n                }\n                this.rows = requiredRows;\n            }\n        }\n    }\n\n    /**\n     * Create a new grid with specified columns and rows.\n     */\n    //% block=\"create grid with %cols columns and %rows rows\"\n    //% cols.defl=5 rows.defl=5\n    //% blockSetVariable=myGrid\n    export function createGrid(cols: number, rows: number): Grid {\n        return new Grid(cols, rows);\n    }\n}\n"]]}]}]},{"timestamp":1789233491950,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":182,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"u!t7L)ZjoKaMh}g[KD8z\">this</variable><variable id=\"(Pd9v[f@y==nj1)t/;^]\">myGrid</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"gridTools_Grid_configureBoundaries\"><value name=\"this\"><block type=\"variables_get\"><field name=\"VAR\" id=\"(Pd9v[f@y==nj1)t/;^]\">myGrid</field></block></value><value name=\"name\"><shadow type=\"text\"><field name=\"TEXT\">myGrid</field></shadow></value><value name=\"limit\"><shadow type=\"toggleOnOff\"><field name=\"on\">false</field></shadow></value><value name=\"maxCols\"><shadow type=\"ma