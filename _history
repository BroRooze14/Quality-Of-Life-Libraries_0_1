1 value.max=255\n    export function generateRandomAscii(value: number): string {\n        let random_text = \"\"\n        for (let index = 0; index < value; index++) {\n            // String.fromCharCode generates the character from the ASCII number\n            random_text = \"\" + random_text + String.fromCharCode(randint(23, 126))\n        }\n        return random_text\n    }\n}\n","custom2.ts":"/**\n * Custom blocks for probability and logic\n */\n//% weight=90 color=#1f85de icon=\"\\uf042\" block=\"Logic Tools\"\nnamespace logicTools {\n\n    /**\n     * Randomly returns true or false (50/50 chance).\n     */\n    //% block=\"random true or false\"\n    export function randomBoolean(): boolean {\n        // randint(0, 1) returns either 0 or 1. If it's 1, it returns true.\n        return randint(0, 1) === 1;\n    }\n}\n","custom3.ts":"/**\n * Custom blocks for creating and managing 2D grids\n */\n//% weight=100 color=#6a1b9a icon=\"\\uf00a\" block=\"Grid Tools\"\nnamespace gridTools {\n\n    //% blockNamespace=gridTools\n    export class Grid {\n        private data: string[][];\n        private rows: number;\n        private cols: number;\n        private placeholder: string;\n        private useDescriptiveEmpty: boolean;\n        private name: string;\n\n        private limitSize: boolean;\n        private maxCols: number;\n        private maxRows: number;\n\n        constructor(cols: number, rows: number) {\n            this.cols = cols;\n            this.rows = rows;\n            this.placeholder = \".\";\n            this.useDescriptiveEmpty = false;\n            this.name = \"myGrid\";\n\n            // Default constraints\n            this.limitSize = false;\n            this.maxCols = cols;\n            this.maxRows = rows;\n\n            this.data = [];\n            this.clearAll();\n        }\n\n        /**\n         * Configure boundary restrictions and assign a variable identifier name for reporting.\n         */\n        //% block=\"configure boundaries for $this name $name | limit size $limit | max columns $maxCols max rows $maxRows\"\n        //% limit.shadow=toggleOnOff name.defl=\"myGrid\"\n        //% maxCols.defl=10 maxRows.defl=10\n        public configureBoundaries(name: string, limit: boolean, maxCols: number, maxRows: number): void {\n            this.name = name;\n            this.limitSize = limit;\n            this.maxCols = maxCols;\n            this.maxRows = maxRows;\n        }\n\n        /**\n         * Expands the internal memory array safely if the grid is set to scale dynamically.\n         */\n        private expandGridIfNeeded(targetX: number, targetY: number): void {\n            let requiredCols = Math.max(this.cols, targetX + 1);\n            let requiredRows = Math.max(this.rows, targetY + 1);\n\n            // Pad existing rows with extra columns\n            if (requiredCols > this.cols) {\n                for (let y = 0; y < this.rows; y++) {\n                    while (this.data[y].length < requiredCols) {\n                        this.data[y].push(this.placeholder);\n                    }\n                }\n                this.cols = requiredCols;\n            }\n\n            // Construct entirely new rows\n            if (requiredRows > this.rows) {\n                for (let y = this.rows; y < requiredRows; y++) {\n                    let rowArray: string[] = [];\n                    for (let x = 0; x < this.cols; x++) {\n                        rowArray.push(this.placeholder);\n                    }\n                    this.data.push(rowArray);\n                }\n                this.rows = requiredRows;\n            }\n        }\n\n        /**\n         * Set a value at a specific X and Y coordinate.\n         */\n        //% block=\"set $this value at x $x y $y to $value\"\n        //% x.defl=0 y.defl=0 value.defl=\"X\"\n        public set(x: number, y: number, value: string): void {\n            if (x < 0 || y < 0) {\n                serial.writeLine(this.name + \" (\" + x + \",\" + y + \") out of grid range\");\n                return;\n            }\n\n            if (this.limitSize) {\n                if (x >= this.maxCols || y >= this.maxRows) {\n                    serial.writeLine(this.name + \" (\" + x + \",\" + y + \") out of grid range\");\n                    return;\n                }\n                // Even with boundaries active, expand up to the maximum permitted ceiling if needed\n                this.expandGridIfNeeded(x, y);\n            } else {\n                // Unlimited size: Automatically scale row/column tracking to make room\n                this.expandGridIfNeeded(x, y);\n            }\n\n            this.data[y][x] = value;\n        }\n\n        /**\n         * Get a value from a specific X and Y coordinate.\n         */\n        //% block=\"get value from $this at x $x y $y\"\n        //% x.defl=0 y.defl=0\n        public get(x: number, y: number): string {\n            if (x >= 0 && x < this.cols && y >= 0 && y < this.rows) {\n                return this.data[y][x];\n            }\n            return this.useDescriptiveEmpty ? \"(-empty-)\" : this.placeholder;\n        }\n\n        /**\n         * Set a custom default character for empty cells.\n         */\n        //% block=\"set default character for $this to $char\"\n        //% char.defl=\".\"\n        public setDefaultCharacter(char: string): void {\n            let oldPlaceholder = this.placeholder;\n            this.placeholder = char;\n\n            for (let y = 0; y < this.rows; y++) {\n                for (let x = 0; x < this.cols; x++) {\n                    if (this.data[y][x] === oldPlaceholder) {\n                        this.data[y][x] = this.placeholder;\n                    }\n                }\n            }\n        }\n\n        /**\n         * Toggle whether unwritten slots display as (-empty-) instead of the default character.\n         */\n        //% block=\"use descriptive empty label (-empty-) for $this $enabled\"\n        //% enabled.shadow=toggleOnOff\n        public setUseDescriptiveEmpty(enabled: boolean): void {\n            this.useDescriptiveEmpty = enabled;\n        }\n\n        /**\n         * Clear a specific coordinate back to the default state.\n         */\n        //% block=\"clear coordinate at x $x y $y in $this\"\n        //% x.defl=0 y.defl=0\n        public clearCoordinate(x: number, y: number): void {\n            if (x >= 0 && x < this.cols && y >= 0 && y < this.rows) {\n                this.data[y][x] = this.placeholder;\n            }\n        }\n\n        /**\n         * Reset the entire grid back to empty placeholders.\n         */\n        //% block=\"reset grid $this\"\n        public clearAll(): void {\n            this.data = [];\n            // If limited, match base sizes to maximums; otherwise use safe starting dimensions\n            let initialRows = this.limitSize ? this.maxRows : this.rows;\n            let initialCols = this.limitSize ? this.maxCols : this.cols;\n\n            this.rows = initialRows > 0 ? initialRows : 1;\n            this.cols = initialCols > 0 ? initialCols : 1;\n\n            for (let y = 0; y < this.rows; y++) {\n                let rowArray: string[] = [];\n                for (let x = 0; x < this.cols; x++) {\n                    rowArray.push(this.placeholder);\n                }\n                this.data.push(rowArray);\n            }\n        }\n\n        /**\n         * Print the complete grid layout to the terminal.\n         */\n        //% block=\"show $this in terminal\"\n        public showInTerminal(): void {\n            serial.writeLine(\"--- Grid Render: \" + this.name + \" ---\");\n            for (let y = 0; y < this.rows; y++) {\n                let rowString = \"\";\n                for (let x = 0; x < this.cols; x++) {\n                    let currentVal = this.data[y][x];\n                    if (this.useDescriptiveEmpty && currentVal === this.placeholder) {\n                        rowString += \"(-empty-) \";\n                    } else {\n                        rowString += currentVal + \" \";\n                    }\n                }\n                serial.writeLine(rowString);\n            }\n            serial.writeLine(\"-------------------\");\n        }\n    }\n\n    /**\n     * Create a new grid with specified columns and rows.\n     */\n    //% block=\"create grid with $cols columns and $rows rows\"\n    //% cols.defl=5 rows.defl=5\n    //% blockSetVariable=myGrid\n    export function createGrid(cols: number, rows: number): Grid {\n        return new Grid(cols, rows);\n    }\n}\n","pxt.json":"{\n    \"name\": \"random letter generator asci\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\",\n        \"custom.ts\",\n        \"custom2.ts\",\n        \"custom3.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1789233491928,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"u!t7L)ZjoKaMh}g[KD8z\">this</variable><variable id=\"(Pd9v[f@y==nj1)t/;^]\">myGrid</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"gridTools_Grid_configureBoundaries\"><value name=\"this\"><block type=\"variables_get\"><field name=\"VAR\" id=\"(Pd9v[f@y==nj1)t/;^]\">myGrid</field></block></value><value name=\"name\"><shadow type=\"text\"><field name=\"TEXT\">myGrid</field></shadow></value><value name=\"limit\"><shadow type=\"toggleOnOff\"><field name=\"on\">false</field></shadow></value><value name=\"maxCols\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value><value name=\"maxRows\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value></block></statement></block></xml>","ma